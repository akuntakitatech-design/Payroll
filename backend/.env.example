# ===== Database (MariaDB) =====
# Pilihan 1: URL lengkap (dipakai di Coolify -> gunakan hostname internal service MariaDB)
DATABASE_URL=mysql://mariadb:PASSWORD@mariadb:3306/hris_payroll
# Pilihan 2: komponen terpisah (dipakai jika DATABASE_URL kosong)
# DB_HOST=mariadb
# DB_PORT=3306
# DB_USER=mariadb
# DB_PASSWORD=
# DB_NAME=hris_payroll
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Uji koneksi ("SELECT 1") setiap kali koneksi diambil dari kolam.
# Biarkan true bila database berada di jaringan yang sama (aman & murah).
# Set false bila database berada JAUH (latensi tinggi, mis. live preview yang
# menunjuk ke MariaDB produksi) karena setiap pengambilan koneksi akan
# menambah satu perjalanan jaringan penuh dan membuat halaman terasa lambat.
DB_POOL_PRE_PING=true

# ===== App =====
CORS_ORIGINS=*
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
MAX_UPLOAD_MB=15
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=10
# Seed data demo saat startup (true/false)
AUTO_SEED=true

# ===== Mode HANYA-BACA (READ-ONLY) =====
# Set true bila aplikasi ditunjuk ke DATABASE/BUCKET PRODUKSI dari lingkungan
# non-produksi (mis. live preview) dan Anda hanya ingin MELIHAT data asli.
# Efek saat aktif:
#   - Semua INSERT / UPDATE / DELETE ke tabel bisnis diblokir (HTTP 423)
#   - Upload & hapus objek Cloudflare R2 diblokir (unduh/pratinjau tetap jalan)
#   - Sinkronisasi skema & pembuatan indeks (DDL) dilewati
#   - Seed data demo dan penjadwal pengingat (email) dinonaktifkan
#   - Tulisan ke tabel users/audit_logs/reminder_logs/payslip_email_logs
#     di-abaikan tanpa error, agar alur login tetap berfungsi normal
# Status mode dapat diperiksa lewat endpoint GET /api/system/mode
READ_ONLY=false

# ===== Cloudflare R2 (S3 compatible) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Opsional: default https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# URL publik bucket (opsional), mis. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_PREFIX=hris-payroll


# ===== Development terisolasi (opsional; tidak diaktifkan otomatis) =====
APP_ENV=production
ENABLE_SCHEDULER=true
# Isi hanya untuk bootstrap_development.py pada MariaDB lokal terpisah.
DEVELOPMENT_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_COMPANY_CODE=
DEV_COMPANY_NAME=
