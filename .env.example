# ===== docker-compose (root) =====
# Database
MARIADB_ROOT_PASSWORD=ganti-root-password
MARIADB_DATABASE=hris_payroll
MARIADB_USER=mariadb
MARIADB_PASSWORD=ganti-password

# phpMyAdmin
PMA_PORT=8080
PMA_ABSOLUTE_URI=

# Backend
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
CORS_ORIGINS=*
AUTO_SEED=true
MAX_UPLOAD_MB=15

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
# URL publik bucket (opsional), mis. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=

# Frontend
# kosong = pakai /api relatif via Nginx proxy (disarankan)
REACT_APP_BACKEND_URL=
FRONTEND_PORT=3000
